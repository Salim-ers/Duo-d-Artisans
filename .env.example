# ─────────────────────────────────────────────────────────────
# Le Duo d’Artisans — variables d’environnement
# Copiez ce fichier en .env.local (développement) ou saisissez-les dans Vercel → Settings → Environment Variables.
# AUCUNE valeur secrète ne doit être commitée ni préfixée par NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Domaine public du site (sans slash final). Vide = https://www.leduodartisans.fr
NEXT_PUBLIC_SITE_URL=https://www.leduodartisans.fr
# URL utilisée dans les e-mails et les retours de paiement (par défaut : NEXT_PUBLIC_SITE_URL)
SITE_URL=

# ── Base de données PostgreSQL (Neon, offre gratuite) ──
# Vercel → projet → Storage → Create Database → Neon : DATABASE_URL et DATABASE_URL_UNPOOLED sont ajoutées seules.
# Tables, sécurité (RLS) et données initiales créées automatiquement au premier démarrage.
# Laisser vide en local : une base PGlite est créée dans .data/pglite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Gestion (/admin) ──
# Clé de signature des sessions (32 caractères minimum, ex. : openssl rand -base64 48).
# Facultative avec Neon (dérivée de DATABASE_URL), recommandée.
AUTH_SECRET=
# Premier compte super administrateur, créé au premier démarrage tant qu’aucun compte n’existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── E-mails (Resend, facultatif) ──
# Sans clé : les e-mails sont journalisés dans la gestion (fiche de la demande) mais non envoyés.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend
EMAIL_FROM=Le Duo d’Artisans <gateaux@leduodartisans.fr>
# Boîte de l’équipe (modifiable aussi dans Gestion → Paramètres → Notifications)
STAFF_EMAIL=

# ── Notifications push de la gestion (facultatif) ──
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@leduodartisans.fr

# ── Cloudflare Turnstile (facultatif, en cas de spam sur les formulaires) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
