# À renseigner dans Vercel → Settings → Environment Variables (jamais dans le code).

# Domaine public du site (sans slash final). Vide = https://www.leduodartisans.fr
NEXT_PUBLIC_SITE_URL=https://www.leduodartisans.fr

# --- Envoi des formulaires (serveur uniquement, NE PAS préfixer par NEXT_PUBLIC_) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur sur un domaine vérifié chez Resend, ex. « Site Le Duo d’Artisans <site@leduodartisans.fr> »
CONTACT_FROM_EMAIL=

# --- Cloudflare Turnstile (facultatif, en cas de spam) ---
# La clé de site est publique par nature ; la clé secrète reste côté serveur.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
