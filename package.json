{
  "name": "le-duo-artisans",
  "version": "1.0.0",
  "private": true,
  "description": "Le Duo d’Artisans — site, commande en ligne avec retrait en boutique et gestion de la boulangerie-pâtisserie (Rantigny, 60290)",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-images.mjs",
    "build": "next build",
    "start": "next start",
    "check:images": "node scripts/check-images.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:reset-local": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
